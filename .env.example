# Shared Consignment PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consignment?schema=public"

# Authentication secret (shared secret with Consignment ecosystem)
AUTH_SECRET="CHANGE_ME_same_value_as_consignment_JWT_SECRET_min_32_chars"
JWT_SECRET="CHANGE_ME_same_value_as_consignment_JWT_SECRET_min_32_chars"

# Application URL
APP_URL="https://appointment.averretail.com"
PORT=3001
NODE_ENV="development"
# FACTORY_RESET_KEY is only used by the consignment app; do not put it here.

# Extra usernames (exact, comma-separated) allowed into the Appointment app besides ADMIN
# and users whose department is exactly "Dispatch" or "Logistics".
APPOINTMENT_ALLOWED_USERNAMES="iqbal,dispatch"
