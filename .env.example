# Shared Consignment PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/consignment?schema=public"

# Authentication secret (shared secret with Consignment ecosystem)
AUTH_SECRET="CHANGE_ME_same_value_as_consignment_JWT_SECRET_min_32_chars"
JWT_SECRET="CHANGE_ME_same_value_as_consignment_JWT_SECRET_min_32_chars"

# Application URL
APP_URL="https://appointment.averretail.com"
PORT=3001
NODE_ENV="development"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="administrator@passkey"
# FACTORY_RESET_KEY is only used by the consignment app; do not put it here.

# Extra usernames (exact, comma-separated) allowed into the Appointment app besides ADMIN
# and users whose department is exactly "Dispatch" or "Logistics".
APPOINTMENT_ALLOWED_USERNAMES="iqbal,dispatch"

# ---------------------------------------------------------------------------
# Delhivery One B2B (LTL) API — server-side only, never exposed to the browser.
# This is the LTL client API (ltl-clients-api*.delhivery.com), NOT B2C Express.
# ---------------------------------------------------------------------------
# "test" (staging) or "production". Defaults to test.
DELHIVERY_ENV="test"
# Optional base URL overrides (defaults shown):
# DELHIVERY_BASE_URL_TEST="https://ltl-clients-api-dev.delhivery.com"
# DELHIVERY_BASE_URL_PROD="https://ltl-clients-api.delhivery.com"
# Use separate credentials for test and production. A wrong password locks the account for 10 minutes.
DELHIVERY_USERNAME=""
DELHIVERY_PASSWORD=""
# Exact registered pickup warehouse name (case- and space-sensitive).
DELHIVERY_WAREHOUSE_NAME=""
# Pickup origin pincode.
DELHIVERY_SOURCE_PIN="700100"
# Must be "true" before the app can create LRs (POST /manifest). Leave false until verified on staging.
DELHIVERY_BOOKING_ENABLED="false"

# ---------------------------------------------------------------------------
# Shiprocket Cargo (B2B) — spec: api_docs/shiprocket_cargo_openapi.json
# Allowed only for Swiggy, Blinkit and Flipkart Minutes. Land / surface only.
# ---------------------------------------------------------------------------
# Optional base URL override (default shown):
# SHIPROCKET_BASE_URL="https://api-cargo.shiprocket.in"
# Refresh token from the Shiprocket Cargo panel (valid 1 year). The app exchanges it for a 1-day access token.
SHIPROCKET_REFRESH_TOKEN=""
# Your Shiprocket Cargo client id (a number, shown in the panel / API responses).
SHIPROCKET_CLIENT_ID=""
# Our pickup point (all mandatory for booking).
SHIPROCKET_SENDER_WAREHOUSE_NAME=""
SHIPROCKET_SENDER_ADDRESS_LINE1=""
SHIPROCKET_SENDER_ADDRESS_LINE2=""
SHIPROCKET_SENDER_PINCODE="700100"
SHIPROCKET_SENDER_CITY="Kolkata"
SHIPROCKET_SENDER_STATE="West Bengal"
SHIPROCKET_SENDER_CONTACT_NAME=""
SHIPROCKET_SENDER_CONTACT_EMAIL=""
SHIPROCKET_SENDER_CONTACT_PHONE=""
# Must be "true" before the app can create orders/shipments. Rates and tracking work without it.
SHIPROCKET_BOOKING_ENABLED="false"
