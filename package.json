{
  "name": "appointment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/appointment-plan-v2.test.ts && tsx tests/channel-aliases-and-pending-query.test.ts",
    "test:integration": "tsx tests/appointment-core.test.ts",
    "prisma:generate": "prisma generate",
    "db:start": "pg_ctl -D ~/.local/share/postgres-data -l ~/.local/share/postgres-data/server.log start",
    "db:stop": "pg_ctl -D ~/.local/share/postgres-data stop",
    "db:status": "pg_isready -h localhost -p 5432",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
